# AEGIS 3.0 NAS deployment environment template (Phase 7 + optional Phase 9 TLS).
#
# Copy to `.env.nas` (gitignored) and replace every placeholder. Never commit `.env.nas`
# or real hostnames, private IPs, passwords, API keys, SSH paths, or TLS PEMs.
#
# See docker/nas/README.md, docs/architecture/decisions/0008-phase-7-nas-deployment.md,
# and docs/architecture/decisions/0010-phase-9-nas-tls-reverse-proxy.md.

# --- Workstation → NAS connection (package/deploy/verify scripts) ----------
# Replace with your NAS SSH endpoint. Do not use a real value in any committed file.
AEGIS_NAS_SSH_HOST=replace-with-nas-ssh-hostname-or-ip
AEGIS_NAS_SSH_USER=replace-with-nas-ssh-username
AEGIS_NAS_SSH_PORT=22
# Absolute directory on the NAS where the package will be unpacked.
AEGIS_NAS_REMOTE_DIR=replace-with-absolute-remote-deploy-directory
AEGIS_NAS_COMPOSE_PROJECT_NAME=aegis

# Optional: path to an SSH private key for scp/ssh (leave empty to use ssh-agent / default).
# AEGIS_NAS_SSH_IDENTITY_FILE=

# Public base URLs used by verify scripts (how you reach the stack after deploy).
# Must match how browsers and curl reach the NAS-published ports or reverse proxy.
AEGIS_NAS_API_BASE_URL=https://replace-with-operator-facing-api-origin
AEGIS_NAS_FRONTEND_BASE_URL=https://replace-with-operator-facing-frontend-origin
# Optional symbol for research / calibration-readiness verify checks (default AAPL).
# AEGIS_NAS_VERIFY_SYMBOL=AAPL

# --- Stack (consumed by docker compose --env-file .env.nas) ----------------
AEGIS_ENVIRONMENT=production

# CORS: must include the exact browser origin of the operator console (scheme+host[+port]).
AEGIS_CORS_ORIGINS=https://replace-with-operator-facing-frontend-origin

# Operator auth (Phase 4). Mandatory non-default password for NAS.
# Seeded only when the operators table is empty. Change before first start.
AEGIS_OPERATOR_USERNAME=operator
AEGIS_OPERATOR_PASSWORD=replace-with-strong-non-default-nas-operator-password
AEGIS_SESSION_COOKIE_NAME=aegis_session
AEGIS_SESSION_TTL_SECONDS=86400
# Set true when the console is served over HTTPS (required for Secure cookies).
AEGIS_SESSION_COOKIE_SECURE=true

# Baked into the frontend image at package/build time (Next.js NEXT_PUBLIC_*).
NEXT_PUBLIC_API_BASE_URL=https://replace-with-operator-facing-api-origin

# Published ports on the NAS host when TLS overlay is OFF (Postgres/Redis stay unpublished).
# When AEGIS_NAS_TLS_ENABLED=true, the TLS overlay unpublishes API/frontend host ports.
AEGIS_API_PORT=8000
FRONTEND_PORT=3000

# Database credentials inside the Compose network (not published on NAS).
POSTGRES_USER=aegis
POSTGRES_PASSWORD=replace-with-strong-non-default-nas-db-password
POSTGRES_DB=aegis

# Market data (optional at start; ingestion fails closed if unset when invoked).
# Primary/secondary: alpha_vantage | polygon (ADR-0011). Leave secondary empty to disable failover.
AEGIS_DAILY_BAR_PRIMARY_SOURCE=alpha_vantage
AEGIS_DAILY_BAR_SECONDARY_SOURCE=polygon
AEGIS_ALPHA_VANTAGE_API_KEY=replace-with-your-alpha-vantage-api-key
AEGIS_POLYGON_API_KEY=replace-with-your-polygon-api-key
AEGIS_WATCHLIST_SYMBOLS=AAPL,MSFT,SPY
AEGIS_INGESTION_SCHEDULE_ENABLED=true
AEGIS_INGESTION_CRON=0 22 * * 1-5
AEGIS_EXCHANGE_CALENDAR_NAME=NYSE
AEGIS_MAX_LATEST_BAR_STALENESS_TRADING_DAYS=3
AEGIS_DAILY_BAR_OUTPUT_SIZE=compact
# Phase 8: post-ingest research after successful scheduled/on-demand ingest (ADR-0009).
AEGIS_RESEARCH_SCHEDULE_AFTER_INGEST_ENABLED=true
# Phase 14: post-assessment outcome labels (research-only; ADR-0015).
AEGIS_RESEARCH_OUTCOME_LABEL_AFTER_ASSESSMENT_ENABLED=true
# Phase 15: research probability calibration (research-only; ADR-0016). Default false.
AEGIS_RESEARCH_CALIBRATION_AFTER_LABEL_ENABLED=false
AEGIS_RESEARCH_CALIBRATION_MIN_CORPUS=10
AEGIS_RESEARCH_CALIBRATION_MIN_BUCKET=5
AEGIS_RESEARCH_CALIBRATION_INDEX_BUCKET_WIDTH=0.15
# Phase 11: multi-source coverage weighting (research-only; ADR-0012).
AEGIS_RESEARCH_MULTI_SOURCE_COVERAGE_ENABLED=true
AEGIS_RESEARCH_MULTI_SOURCE_CLOSE_TOLERANCE=0.002
AEGIS_RESEARCH_MULTI_SOURCE_DISAGREEMENT_FAIL_CLOSED=false
AEGIS_RESEARCH_ALLOW_CROSS_SOURCE_COMPONENT_FILL=false

# --- Optional Phase 9 TLS reverse proxy (ADR-0010) -------------------------
# Set true to include docker/nas/docker-compose.nas.tls.yml (Caddy). Proxy is TLS +
# routing only — NOT Basic Auth. App sessions (Phase 4) remain the auth model.
AEGIS_NAS_TLS_ENABLED=false
# files = operator PEMs (default for private NAS LAN); acme = public DNS + Let's Encrypt.
AEGIS_TLS_MODE=files
# Hostnames only (no scheme). Required when TLS is enabled.
AEGIS_TLS_FRONTEND_HOST=replace-with-frontend-hostname
AEGIS_TLS_API_HOST=replace-with-api-hostname
AEGIS_TLS_HTTPS_PORT=443
AEGIS_TLS_HTTP_PORT=80
# Paths relative to docker/nas/ (the TLS compose file directory). Absolute NAS paths OK.
AEGIS_TLS_CADDYFILE=./proxy/Caddyfile.files
AEGIS_TLS_CERTS_DIR=./proxy/certs
# Required for AEGIS_TLS_MODE=acme (contact email for certificate issuance).
AEGIS_TLS_ACME_EMAIL=replace-with-operator-acme-contact-email
# When TLS is enabled, keep Secure cookies and https:// public origins aligned:
#   AEGIS_SESSION_COOKIE_SECURE=true
#   AEGIS_CORS_ORIGINS=https://<frontend-host>
#   NEXT_PUBLIC_API_BASE_URL=https://<api-host>
#   AEGIS_NAS_API_BASE_URL / AEGIS_NAS_FRONTEND_BASE_URL = https://...
# Optional lab-only: allow verify curl to skip TLS cert verification (self-signed).
# AEGIS_NAS_VERIFY_CURL_INSECURE=false
