# AEGIS 3.0 environment configuration template.
#
# Copy this file to `.env` for local development (`.env` is gitignored). Every variable
# used anywhere in the stack must be documented here with a non-functional placeholder value.
# See docs/operations/configuration.md for a full description of each variable.
#
# Never commit a `.env` file or any real secret, hostname, or credential.

# --- Shared ---------------------------------------------------------------
AEGIS_ENVIRONMENT=development

# --- Backend (aegis.config.settings.Settings) -----------------------------
AEGIS_DATABASE_URL=postgresql+asyncpg://aegis:aegis@localhost:5432/aegis
AEGIS_REDIS_URL=redis://localhost:6379/0
AEGIS_READINESS_TIMEOUT_SECONDS=2.0
AEGIS_API_HOST=0.0.0.0
AEGIS_API_PORT=8000

# --- Backend: Phase 3 operator console (CORS) -----------------------------
AEGIS_CORS_ORIGINS=http://localhost:3000

# --- Backend: Phase 1 market data ingestion -------------------------------
# Replace with a real Alpha Vantage API key (https://www.alphavantage.co/support/#api-key)
# for local ingestion; never commit a real key.
AEGIS_ALPHA_VANTAGE_API_KEY=replace-with-your-alpha-vantage-api-key
AEGIS_ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
AEGIS_ALPHA_VANTAGE_REQUEST_INTERVAL_SECONDS=12.0
AEGIS_WATCHLIST_SYMBOLS=AAPL,MSFT,SPY
AEGIS_DAILY_BAR_OUTPUT_SIZE=compact
AEGIS_EXCHANGE_CALENDAR_NAME=NYSE
AEGIS_MAX_LATEST_BAR_STALENESS_TRADING_DAYS=3

# --- Backend: Phase 2 scheduled ingestion & watchlist ---------------------
AEGIS_INGESTION_SCHEDULE_ENABLED=true
AEGIS_INGESTION_CRON=0 22 * * 1-5
AEGIS_INGESTION_SCHEDULE_LOCK_KEY=aegis:ingestion:scheduler:lock
AEGIS_INGESTION_SCHEDULE_LOCK_TTL_SECONDS=1800

# --- PostgreSQL / TimescaleDB container (docker-compose.yml) --------------
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegis
POSTGRES_PORT=5432

# --- Redis container (docker-compose.yml) ---------------------------------
REDIS_PORT=6379

# --- Frontend (frontend/.env.local for Next.js) ---------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=3000
