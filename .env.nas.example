# AEGIS 3.0 NAS deployment environment template (Phase 7).
#
# Copy to `.env.nas` (gitignored) and replace every placeholder. Never commit `.env.nas`
# or real hostnames, private IPs, passwords, API keys, or SSH paths.
#
# See docker/nas/README.md and docs/architecture/decisions/0008-phase-7-nas-deployment.md.

# --- Workstation → NAS connection (package/deploy/verify scripts) ----------
# Replace with your NAS SSH endpoint. Do not use a real value in any committed file.
AEGIS_NAS_SSH_HOST=replace-with-nas-ssh-hostname-or-ip
AEGIS_NAS_SSH_USER=replace-with-nas-ssh-username
AEGIS_NAS_SSH_PORT=22
# Absolute directory on the NAS where the package will be unpacked.
AEGIS_NAS_REMOTE_DIR=replace-with-absolute-remote-deploy-directory
AEGIS_NAS_COMPOSE_PROJECT_NAME=aegis

# Optional: path to an SSH private key for scp/ssh (leave empty to use ssh-agent / default).
# AEGIS_NAS_SSH_IDENTITY_FILE=

# Public base URLs used by verify scripts (how you reach the stack after deploy).
# Must match how browsers and curl reach the NAS-published ports or reverse proxy.
AEGIS_NAS_API_BASE_URL=https://replace-with-operator-facing-api-origin
AEGIS_NAS_FRONTEND_BASE_URL=https://replace-with-operator-facing-frontend-origin

# --- Stack (consumed by docker compose --env-file .env.nas) ----------------
AEGIS_ENVIRONMENT=production

# CORS: must include the exact browser origin of the operator console (scheme+host[+port]).
AEGIS_CORS_ORIGINS=https://replace-with-operator-facing-frontend-origin

# Operator auth (Phase 4). Mandatory non-default password for NAS.
# Seeded only when the operators table is empty. Change before first start.
AEGIS_OPERATOR_USERNAME=operator
AEGIS_OPERATOR_PASSWORD=replace-with-strong-non-default-nas-operator-password
AEGIS_SESSION_COOKIE_NAME=aegis_session
AEGIS_SESSION_TTL_SECONDS=86400
# Set true when the console is served over HTTPS (required for Secure cookies).
AEGIS_SESSION_COOKIE_SECURE=true

# Baked into the frontend image at package/build time (Next.js NEXT_PUBLIC_*).
NEXT_PUBLIC_API_BASE_URL=https://replace-with-operator-facing-api-origin

# Published ports on the NAS host (Postgres/Redis are not published by the NAS overlay).
AEGIS_API_PORT=8000
FRONTEND_PORT=3000

# Database credentials inside the Compose network (not published on NAS).
POSTGRES_USER=aegis
POSTGRES_PASSWORD=replace-with-strong-non-default-nas-db-password
POSTGRES_DB=aegis

# Market data (optional at start; ingestion fails closed if unset when invoked).
AEGIS_ALPHA_VANTAGE_API_KEY=replace-with-your-alpha-vantage-api-key
AEGIS_WATCHLIST_SYMBOLS=AAPL,MSFT,SPY
AEGIS_INGESTION_SCHEDULE_ENABLED=true
AEGIS_INGESTION_CRON=0 22 * * 1-5
AEGIS_EXCHANGE_CALENDAR_NAME=NYSE
AEGIS_MAX_LATEST_BAR_STALENESS_TRADING_DAYS=3
AEGIS_DAILY_BAR_OUTPUT_SIZE=compact
