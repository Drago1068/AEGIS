# Environment
.env
.env.*
!.env.example
!.env.nas.example
# `.env.nas` is covered by `.env.*` above; never commit NAS host/credential files.

# NAS package build output (image tarballs and staged transfer dirs)
docker/nas/dist/

# Operator-supplied TLS material for Phase 9 NAS proxy (never commit PEMs)
docker/nas/proxy/certs/*
!docker/nas/proxy/certs/.gitkeep
!docker/nas/proxy/certs/README.md
*.pem
*.crt
*.key

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Generated by `uv export` for the pip-audit command in docs/operations/security-scanning.md
backend/pip-audit-requirements.txt

# Node
node_modules/
.next/

# Build output
dist/
coverage/
.coverage
*.cover

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Local editor state
*.code-workspace
