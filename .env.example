# AEGIS 3.0 environment configuration template.
#
# Copy this file to `.env` for local development (`.env` is gitignored). Every variable
# used anywhere in the stack must be documented here with a non-functional placeholder value.
# See docs/operations/configuration.md for a full description of each variable.
#
# Never commit a `.env` file or any real secret, hostname, or credential.

# --- Shared ---------------------------------------------------------------
AEGIS_ENVIRONMENT=development

# --- Backend (aegis.config.settings.Settings) -----------------------------
AEGIS_DATABASE_URL=postgresql+asyncpg://aegis:aegis@localhost:5432/aegis
AEGIS_REDIS_URL=redis://localhost:6379/0
AEGIS_READINESS_TIMEOUT_SECONDS=2.0
AEGIS_API_HOST=0.0.0.0
AEGIS_API_PORT=8000

# --- Backend: Phase 3 operator console (CORS) -----------------------------
AEGIS_CORS_ORIGINS=http://localhost:3000

# --- Backend: Phase 1 / Phase 10 market data ingestion --------------------
# Primary/secondary source ids: alpha_vantage | polygon (see ADR-0011).
AEGIS_DAILY_BAR_PRIMARY_SOURCE=alpha_vantage
# Optional failover provider (leave empty to disable). Must differ from primary when set.
AEGIS_DAILY_BAR_SECONDARY_SOURCE=
# Replace with real keys for local ingestion; never commit a real key.
AEGIS_ALPHA_VANTAGE_API_KEY=replace-with-your-alpha-vantage-api-key
AEGIS_ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
AEGIS_ALPHA_VANTAGE_REQUEST_INTERVAL_SECONDS=12.0
AEGIS_POLYGON_API_KEY=replace-with-your-polygon-api-key
AEGIS_POLYGON_BASE_URL=https://api.polygon.io
AEGIS_POLYGON_REQUEST_INTERVAL_SECONDS=12.0
AEGIS_WATCHLIST_SYMBOLS=AAPL,MSFT,SPY
AEGIS_DAILY_BAR_OUTPUT_SIZE=compact
AEGIS_EXCHANGE_CALENDAR_NAME=NYSE
AEGIS_MAX_LATEST_BAR_STALENESS_TRADING_DAYS=3
AEGIS_MARKET_DATA_CORRECTION_PRICE_EPSILON=0.000001

# --- Backend: Phase 2 scheduled ingestion & watchlist ---------------------
AEGIS_INGESTION_SCHEDULE_ENABLED=true
AEGIS_INGESTION_CRON=0 22 * * 1-5
AEGIS_INGESTION_SCHEDULE_LOCK_KEY=aegis:ingestion:scheduler:lock
AEGIS_INGESTION_SCHEDULE_LOCK_TTL_SECONDS=1800

# --- Backend: Phase 8 post-ingest research assessments --------------------
# When true, after successful scheduled (locked) and on-demand ingest, run Phase 6
# daily_bar_research_v1 for active watchlist symbols (stored bars only). See ADR-0009.
AEGIS_RESEARCH_SCHEDULE_AFTER_INGEST_ENABLED=true

# --- Backend: Phase 11 multi-source coverage weighting (research-only) ----
# When true, method_version 2 coverage includes availability/agreement factors (ADR-0012).
# When false, preserve Phase 6 method_version 1 behavior.
AEGIS_RESEARCH_MULTI_SOURCE_COVERAGE_ENABLED=true
AEGIS_RESEARCH_MULTI_SOURCE_CLOSE_TOLERANCE=0.002
AEGIS_RESEARCH_MULTI_SOURCE_DISAGREEMENT_FAIL_CLOSED=false
# Default false: fail closed with insufficient primary-source bars rather than stitching.
AEGIS_RESEARCH_ALLOW_CROSS_SOURCE_COMPONENT_FILL=false

# --- Backend: Phase 4 operator authentication -----------------------------
# Development placeholders only. Change before any non-local exposure; never commit a real
# password. Seeded into the operators table only when that table is empty.
AEGIS_OPERATOR_USERNAME=operator
AEGIS_OPERATOR_PASSWORD=change-me-before-non-local-use
AEGIS_SESSION_COOKIE_NAME=aegis_session
AEGIS_SESSION_TTL_SECONDS=86400
AEGIS_SESSION_COOKIE_SECURE=false

# --- PostgreSQL / TimescaleDB container (docker-compose.yml) --------------
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegis
POSTGRES_PORT=5432

# --- Redis container (docker-compose.yml) ---------------------------------
REDIS_PORT=6379

# --- Frontend (frontend/.env.local for Next.js) ---------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=3000
